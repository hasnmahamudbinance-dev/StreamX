generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  password              String
  role                  String    @default("user")
  avatar                String?
  language              String    @default("en")
  autoplay              Boolean   @default(true)
  emailNotify            Boolean   @default(true)
  emailVerified         Boolean   @default(false)
  emailVerifiedAt       DateTime?
  status                String    @default("active")  // "pending_verification", "active", "suspended", "deleted"
  failedLoginAttempts   Int       @default(0)
  lockedUntil           DateTime?
  twoFactorEnabled      Boolean   @default(false)
  twoFactorMethod       String?   // "email" or "app"
  twoFactorSecret       String?   // TOTP secret for authenticator apps
  recoveryCodes         String?   // JSON array of recovery codes
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  watchlistItems        WatchlistItem[]
  progressItems         PlaybackProgress[]
  watchHistory          WatchHistory[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  ratings               Rating[]
  reviews               Review[]
  reports               ContentReport[]  @relation("ReportSubmitter")
  reviewedReports       ContentReport[]  @relation("ReportReviewer")
  tickets               SupportTicket[]
  messages              SupportMessage[]
  behaviors             UserBehavior[]
  searchHistory         SearchHistory[]
  devices               UserDevice[]
  emailVerificationCodes EmailVerificationCode[]
  passwordResetCodes    PasswordResetCode[]
  sessions              UserSession[]
  profiles              Profile[]
}

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  title       String
  posterPath  String?
  overview    String?
  rating      Float?
  releaseDate String?
  addedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId])
}

model PlaybackProgress {
  id            String   @id @default(cuid())
  userId        String
  contentId     String
  contentType   String
  title         String
  posterPath    String?
  seasonNumber  Int?
  episodeNumber Int?
  position      Int
  duration      Int
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType, seasonNumber, episodeNumber])
  @@index([userId])
}

model WatchHistory {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  title       String
  posterPath  String?
  overview    String?
  rating      Float?
  releaseDate String?
  progress    Int      @default(0)
  duration    Int      @default(0)
  watchedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([userId])
  @@index([watchedAt])
}

model Rating {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  score       Int      // 1-5 stars
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, contentType])
  @@index([contentId])
  @@index([userId])
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String
  title       String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([userId])
  @@index([createdAt])
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   @default("custom")
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items CollectionItem[]
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  contentId    String
  contentType  String
  order        Int      @default(0)

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, contentId, contentType])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  title     String
  message   String
  type      String   @default("info")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model PlatformSettings {
  id          String  @id @default(cuid())
  key         String  @unique
  value       String
  description String?
}

model UploadedContent {
  id             String   @id @default(cuid())
  title          String
  originalTitle  String?
  description    String?
  type           String   // "movie" or "tv"
  status         String   @default("draft") // "draft", "processing", "published", "archived"
  releaseDate    String?
  genres         String?  // comma-separated genre names
  language       String   @default("en")
  runtime        Int      @default(0)
  rating         Float    @default(0)
  posterUrl      String?
  backdropUrl    String?
  trailerUrl     String?
  cast           String?  // JSON string of cast array
  director       String?
  hlsMasterUrl   String?  // URL to master.m3u8
  videoFileSize  Int      @default(0) // bytes
  videoFormat    String?  // mp4, mov, mkv, webm
  videoDuration  Int      @default(0) // seconds
  thumbnailUrl   String?
  views          Int      @default(0)
  watchTime      Int      @default(0) // total seconds watched
  featured       Boolean  @default(false)
  uploadedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  episodes       Episode[]
  subtitles      Subtitle[]
  analytics      ContentAnalytics[]
  schedules      ContentSchedule[]
  homepageItems  HomepageSectionItem[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Episode {
  id             String   @id @default(cuid())
  contentId      String
  seasonNumber   Int      @default(1)
  episodeNumber  Int
  title          String
  description    String?
  runtime        Int      @default(0)
  hlsMasterUrl   String?
  thumbnailUrl   String?
  videoFileSize  Int      @default(0)
  videoFormat    String?
  videoDuration  Int      @default(0)
  status         String   @default("draft")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  content        UploadedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, seasonNumber, episodeNumber])
  @@index([contentId])
}

model Subtitle {
  id          String   @id @default(cuid())
  contentId   String
  episodeId   String?
  language    String
  label       String
  url         String
  format      String   @default("vtt") // vtt, srt
  createdAt   DateTime @default(now())

  content     UploadedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
}

model ContentAnalytics {
  id          String   @id @default(cuid())
  contentId   String
  episodeId   String?
  userId      String?
  action      String   // "view", "play", "pause", "complete", "seek"
  position    Int      @default(0)
  duration    Int      @default(0)
  quality     String?  // "480p", "720p", "1080p"
  device      String?  // "desktop", "mobile", "tablet"
  createdAt   DateTime @default(now())

  content     UploadedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId])
  @@index([createdAt])
  @@index([userId])
}

model ContentSchedule {
  id              String   @id @default(cuid())
  contentId       String
  action          String   // "publish", "archive"
  scheduledAt     DateTime
  executed        Boolean  @default(false)
  executedAt      DateTime?
  createdAt       DateTime @default(now())

  content         UploadedContent @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([scheduledAt])
  @@index([executed])
}

model HomepageSection {
  id          String   @id @default(cuid())
  title       String
  type        String   @default("custom") // "trending", "popular", "top_rated", "now_playing", "on_the_air", "upcoming", "custom"
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       HomepageSectionItem[]

  @@index([order])
}

model HomepageSectionItem {
  id          String   @id @default(cuid())
  sectionId   String
  contentId   String?
  contentType String?  // "tmdb_movie", "tmdb_tv", "uploaded"
  uploadedId  String?  // reference to UploadedContent
  order       Int      @default(0)

  section     HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  uploaded    UploadedContent? @relation(fields: [uploadedId], references: [id], onDelete: SetNull)

  @@index([sectionId])
}

model ErrorLog {
  id          String   @id @default(cuid())
  type        String   // "api", "upload", "playback", "system"
  message     String
  stack       String?
  endpoint    String?
  userId      String?
  metadata    String?  // JSON string with additional context
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
  @@index([resolved])
}

model Backup {
  id          String   @id @default(cuid())
  filename    String
  size        Int      @default(0) // bytes
  type        String   @default("full") // "full", "data_only"
  status      String   @default("completed") // "in_progress", "completed", "failed"
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  type        String   // "welcome", "password_reset", "verification", "notification"
  status      String   @default("sent") // "sent", "failed"
  error       String?
  createdAt   DateTime @default(now())

  @@index([to])
  @@index([createdAt])
}

model ContentReport {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String   // movie or tv
  reason      String   // copyright, inappropriate, broken, other
  description String?
  status      String   @default("pending") // pending, reviewed, resolved, dismissed
  adminNote   String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User  @relation("ReportSubmitter", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReportReviewer", fields: [reviewedBy], references: [id])

  @@index([status])
  @@index([userId])
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  description String
  category    String   @default("other") // technical, billing, content, account, other
  priority    String   @default("medium") // low, medium, high
  status      String   @default("open") // open, in_progress, resolved, closed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([status])
  @@index([userId])
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  message   String
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ─── AI Recommendation Engine Models ──────────────────────────

model UserBehavior {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  contentType String   // "movie" or "tv"
  action      String   // "view", "play", "complete", "rate", "search", "watchlist_add"
  genres      String?  // comma-separated genre IDs
  title       String?
  duration    Int      @default(0)  // watch duration in seconds
  completion  Float    @default(0)  // 0.0 to 1.0
  device      String?  // "desktop", "mobile", "tablet"
  metadata    String?  // JSON string for additional context
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([contentId])
  @@index([action])
  @@index([createdAt])
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  type      String   @default("multi")  // "multi", "movie", "tv", "person"
  results   Int      @default(0)  // number of results found
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([query])
}

model TrendingSearch {
  id        String   @id @default(cuid())
  query     String
  count     Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([query])
}

// ─── Enterprise Security Models ───────────────────────────────

model UserDevice {
  id           String   @id @default(cuid())
  userId       String
  deviceFingerprint String?
  userAgent    String?
  browser      String?
  os           String?
  device       String?  // "desktop", "mobile", "tablet"
  ipAddress    String?
  lastActive   DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceFingerprint])
}

model RateLimitLog {
  id         String   @id @default(cuid())
  ipAddress  String
  endpoint   String
  requests   Int      @default(1)
  windowStart DateTime @default(now())
  blocked    Boolean  @default(false)

  @@unique([ipAddress, endpoint, windowStart])
  @@index([ipAddress])
  @@index([windowStart])
}

// ─── Authentication Models ────────────────────────────────────

model EmailVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([expiresAt])
}

model UserSession {
  id              String   @id @default(cuid())
  userId          String
  deviceName      String?
  platform        String?
  browser         String?
  ipAddress       String?
  refreshTokenHash String?
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
}

model Profile {
  id          String   @id @default(cuid())
  userId      String
  profileName String
  avatar      String?
  isKids      Boolean  @default(false)
  isDefault   Boolean  @default(false)
  pin         String?  // 4-digit PIN for profile protection
  language    String   @default("en")
  autoplay    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
